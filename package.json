{
  "name": "financecave",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @financecave/api exec prisma generate && pnpm --filter @financecave/web build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @financecave/api db:migrate"
  }
}
